APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL is started by docker-compose.production.yml.
POSTGRES_DB=p091
POSTGRES_USER=p091
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public HTTPS origin only. TLS must terminate before requests reach the application.
CORS_ORIGINS=https://monitor.example.com
ALLOWED_HOSTS=monitor.example.com
SESSION_COOKIE_SECURE=true

DATABASE_URL=postgresql://p091:replace-with-a-long-random-password@postgres:5432/p091
REDIS_URL=redis://redis:6379/0
REDIS_EVENT_CHANNEL=p091.events

EVIDENCE_STORAGE_BACKEND=s3
# Enable only after a separate embedding worker/provider is configured.
EMBEDDINGS_ENABLED=false
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MODEL=text-embedding-3-small
EVIDENCE_STORAGE_DIR=./data
EVIDENCE_S3_BUCKET=p091-evidence
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_PUBLIC_BASE_URL=

MODEL_WEIGHTS_HOST_PATH=./models/yolo26l.pt
MODEL_WEIGHTS_PATH=/app/models/detector.pt

ALERT_COOLDOWN_SEC=30
CAMERA_TARGET_FPS=8
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

VLM_ENABLED=false
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
VLM_MODEL=gpt-4o-mini
