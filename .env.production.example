APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Public HTTPS origin only. TLS must terminate before requests reach the application.
CORS_ORIGINS=https://monitor.example.com
ALLOWED_HOSTS=monitor.example.com
SESSION_COOKIE_SECURE=true

MODEL_WEIGHTS_HOST_PATH=./models/yolo11n.pt
MODEL_WEIGHTS_PATH=/app/models/detector.pt

ALERT_COOLDOWN_SEC=30
CAMERA_TARGET_FPS=8
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

VLM_ENABLED=false
OPENAI_API_KEY=
