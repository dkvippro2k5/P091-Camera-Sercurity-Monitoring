# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
# Leave empty for the official OpenAI endpoint. Set to point at an OpenAI-compatible proxy
# instead (e.g. DS2API) -- OPENAI_API_KEY and VLM_MODEL still apply, just aimed elsewhere.
# OPENAI_BASE_URL=https://ds2api-five-phi.vercel.app/v1

# ---- Monitoring ----
ALERT_COOLDOWN_SEC=30
# Abandoned-object rule. Demo / short illustration clips: 2-5. Production (PETS2006/AVSS
# "left luggage" standard): 30-60. Owner search radius and stationary tolerance are
# fractions of frame width.
ABANDON_SEC=2.0
OWNER_RADIUS_RATIO=0.25
STATIONARY_TOLERANCE_RATIO=0.02
CAMERA_TARGET_FPS=5
# Max simultaneous YOLO inferences. 0 = host-aware default (1 on GPU, up to 2 on CPU).
# On a CPU host DO NOT raise this: several 4K inferences in parallel thrash the cores.
# Measured, 4 cameras: sem=2 -> ~3.6 fps/cam, sem=4 -> ~0.2 fps/cam.
CAMERA_MAX_CONCURRENT_INFERENCES=0
# Downscale decoded frames to this height before detection / tracking / display / the VLM
# ring (0 = native). THE knob for a CPU host with 1440p+ sources — a 4K frame is ~5x the
# pipeline cost of 720p. Set 720 when sources are large; leave 0 otherwise or on a GPU.
CAMERA_CAPTURE_MAX_HEIGHT=0
DETECTOR_CONFIDENCE=0.40
MODEL_WEIGHTS_HOST_PATH=./src/vision/weights/yolo26l.pt
MODEL_WEIGHTS_PATH=src/vision/weights/yolo26l.pt
# Only classes used by fall, intrusion, and abandoned-object rules are retained and drawn.
# bed and couch let the fall rule ignore someone lying on one.
DETECTOR_TARGET_LABELS=person,backpack,handbag,suitcase,bed,couch

# ---- VLM triage (PRD §1.2 false-alarm filtering) ----
# Off by default. An empty OPENAI_API_KEY also disables it, so leaving this true without a
# key is safe — alerts simply carry no AI assessment.
VLM_ENABLED=false
VLM_PROVIDER=openai
# Official OpenAI: leave OPENAI_BASE_URL empty and set e.g. gpt-4o-mini here.
# Qwen VL via DashScope (OpenAI-compatible): set
#   OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OPENAI_API_KEY=<your DashScope key>
#   VLM_MODEL=qwen-vl-plus        (vision-capable; qwen3.7-flash is text-only)
# For a qwen3* model on a DashScope base_url the client sends `enable_thinking: False`
# automatically (that mode otherwise adds 8-25s of hidden-token latency per alert); the
# qwen-vl-* models don't run thinking mode, so nothing extra is sent for them.
VLM_MODEL=gpt-4o-mini
VLM_LOCAL_MODEL=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
VLM_LOCAL_DEVICE=auto
VLM_LOCAL_MAX_IMAGE_SIZE=512
VLM_LOCAL_MAX_NEW_TOKENS=64
# Seconds of frames kept before / after an event. Pre-roll must exceed the fall dwell (3s)
# plus the 0.5s velocity window, or the "before" frames miss the fall itself. On a slow
# host, widen both (e.g. 12 / 6): the ring is fed at display_fps, so a longer window is the
# cheapest way to guarantee the clip has frames on both sides of the trigger.
VLM_PRE_ROLL_SEC=5.0
VLM_POST_ROLL_SEC=2.0
# Frames sent to the model per alert. Each is a billed image and adds latency; 4 is enough
# to show a transition. Lower it before raising VLM_PRE_ROLL_SEC if cost/latency matters.
VLM_MAX_FRAMES=6
# Raise for a vision model over a slow link (Qwen VL: 30-40).
VLM_TIMEOUT_SEC=20.0
# Past operator-labelled incidents for the same (camera, label) fed back as few-shot context.
VLM_HISTORY_EXAMPLES=6
# Semantically-similar past incidents (pgvector, needs EMBEDDINGS_ENABLED) folded into the
# triage prompt BEFORE the model answers, so a consistent contradiction in the neighbours
# pulls its confidence down. 0 disables. No effect when embeddings are off.
VLM_SIMILAR_EXAMPLES=3
VLM_SIMILAR_MIN_SIMILARITY=0.75
# A false_positive verdict at/above this confidence auto-hides the alert from the guard.
# Self-reported confidence is uncalibrated -- keep this high. Served in monitoring/status.
VLM_AUTO_SUPPRESS_CONFIDENCE=0.9

# ---- Similar-past-incidents lookup (PLANNED, docs/database/schema.sql) ----
# Off by default. Finds guard-confirmed past incidents whose rule-engine reason reads
# similarly to a new alert's -- system-wide, not filtered to the same camera/label the way
# VLM_HISTORY_EXAMPLES is. Requires DATABASE_URL to be a Postgres database with the `vector`
# extension enabled (`CREATE EXTENSION vector` -- Supabase supports this, but it is not on
# by default on a fresh project). Reuses OPENAI_API_KEY/OPENAI_BASE_URL above; the model and
# dimensions must match whatever that key's provider actually returns for the given model
# name, or every embedding call fails its dimension check.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Whether startup re-adds the cameras in data/cameras.json. True for a real deployment,
# which must come back watching what it was watching. Set false for local work: the saved
# set is whatever the last experiment left behind, and restoring it re-opens every video
# file on each reload before you have asked for a camera at all.
RESTORE_CAMERAS_ON_START=true

ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Durable incident storage (SQLite locally; use a managed database URL in production)
DATABASE_URL=sqlite:///./data/app.db

# Optional Zalo OA notifications. Keep disabled until official credentials are configured.
ZALO_ENABLED=false
ZALO_ACCESS_TOKEN=
ZALO_RECIPIENTS=
