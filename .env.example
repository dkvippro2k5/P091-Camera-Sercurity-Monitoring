# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Qwen Model Studio / DashScope ----
# Beijing endpoint. For Singapore use:
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-qwen-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash

# ---- Monitoring ----
ALERT_COOLDOWN_SEC=30
CAMERA_TARGET_FPS=8

# ---- VLM triage (PRD §1.2 false-alarm filtering) ----
# Off by default. An empty VLM_API_KEY also disables it, so leaving this true without a
# key is safe — alerts simply carry no AI assessment.
VLM_ENABLED=false
# Beijing default. For Singapore use your workspace endpoint instead.
VLM_API_KEY=sk-your-qwen-key-here
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.7-flash
# Seconds of frames kept before / after an event. Pre-roll must exceed the fall dwell (3s)
# plus the 0.5s velocity window, or the "before" frames miss the fall itself.
VLM_PRE_ROLL_SEC=5.0
VLM_POST_ROLL_SEC=2.0
VLM_MAX_FRAMES=6
VLM_TIMEOUT_SEC=20.0
# Past operator-labelled incidents for the same (camera, label) fed back as few-shot context.
VLM_HISTORY_EXAMPLES=6

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
